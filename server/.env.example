# Port used by the Express API.
PORT=5000
# MongoDB connection string; replace with an Atlas URI if needed.
MONGO_URI=mongodb://127.0.0.1:27017/personal-notes-app
# Browser origin allowed to call the API.
CLIENT_URL=http://localhost:5173
# Replace this placeholder with a private, long random secret before running.
JWT_SECRET=replace_this_with_a_long_random_secret
