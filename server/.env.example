# Example environment file for backend configuration.
# Defines the HTTP port, MongoDB connection, and allowed frontend origin.
# JWT_SECRET is used to sign and verify account authentication tokens.
# Replace example values with private settings in the untracked server/.env file.PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/personal-notes-app
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_this_with_a_long_random_secret
